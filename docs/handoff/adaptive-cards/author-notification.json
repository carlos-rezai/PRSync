{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${roundLabel} complete — safe to proceed",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true,
      "color": "Good"
    },
    {
      "type": "FactSet",
      "facts": [{ "title": "PR", "value": "${prTitle}" }]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open PR",
      "url": "${prUrl}"
    }
  ]
}
