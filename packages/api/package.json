{
  "name": "@prsync/api",
  "private": true,
  "version": "0.1.0",
  "description": "PRSync Azure Functions API - round state, ADO service hooks, Teams notifications",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "start": "func start",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/data-tables": "^13.2.0",
    "@azure/functions": "^4.5.0"
  },
  "devDependencies": {
    "azure-functions-core-tools": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
